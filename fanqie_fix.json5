// 番茄免费小说补充规则（配合 id667 订阅使用）
// 设计原则：尽量用文字关键词/结构匹配，不依赖混淆过的 vid，不写死完整文案
// 开启本订阅后，请在 id667 订阅的番茄规则里关闭以下两组，避免重复点击：
//   「功能类-看广告自动领奖励」「局部广告-首页右侧悬浮广告」
// id667 的「功能类-观看广告自动静音」请关闭（本订阅自带静音，两个都开会点两次变回有声）
// id667 的「功能类-误入直播后自动[退出]」可以继续开着
// 需要较新版本的 GKD（旧版不支持 ~= 正则等语法）
{
  id: 1019667,
  name: '番茄补充规则',
  version: 3,
  author: 'local',
  apps: [
    {
      id: 'com.dragon.read',
      name: '番茄免费小说',
      groups: [
        {
          key: 1,
          name: '功能类-听书时长不足自动看视频领到上限',
          desc: '时长不足/用完时自动打开领时长面板并连续看视频，直到按钮消失或达到本次上限；不会点击含「畅听」的特殊奖励',
          enable: true,
          rules: [
            {
              key: 0,
              name: '①时长不足-打开领时长面板',
              actionCd: 5000,
              // 当天广告看完后面板仍会显示「不足」，限次避免反复点宝箱
              actionMaximum: 3,
              resetMatch: 'app',
              matches: [
                '[text~="(?s).*(收听|听书).*(不足|用完|用尽|耗尽).*"][visibleToUser=true]',
                '@[clickable=true] > [text*="领时长"][text.length<10][visibleToUser=true]',
              ],
              // 面板已经打开（能看到看视频按钮）时不再点入口，避免误点宝箱
              excludeMatches: '[text^="看视频"][visibleToUser=true]',
            },
            {
              key: 1,
              name: '②时长不足-点[看视频领时长]',
              actionCd: 3000,
              // 广告加载失败（当前无新视频）时防止死循环
              actionMaximum: 5,
              resetMatch: 'app',
              matches: [
                '[text~="(?s).*(收听|听书).*(不足|用完|用尽|耗尽).*"][visibleToUser=true]',
                '[text^="看视频"][text~="(?s).*(时长|分钟|再得).*"][text!*="畅听"][clickable=true][visibleToUser=true]',
              ],
            },
            {
              key: 2,
              name: '③看完一个后继续领-直到上限',
              desc: '只在刚关掉奖励广告之后触发；每次打开番茄最多连续 8 次',
              preKeys: [10],
              actionDelay: 1500,
              actionMaximum: 8,
              resetMatch: 'app',
              matches: '[text^="看视频"][text~="(?s).*(时长|分钟|再得).*"][text!*="畅听"][clickable=true][visibleToUser=true]',
            },
            {
              key: 10,
              name: '广告-奖励已到手-点[关闭]',
              desc: '右上角描述变成「获得xx，关闭」即已获得奖励',
              // 不限定 activity：不同版本广告页类名可能不同，靠描述文字限定
              actionDelay: 800,
              anyMatches: [
                // 从上往下找：部分机型/系统取不到父节点，「子 < 父」写法会失效
                '[desc*="关闭"][desc!*="秒"][desc~="(?s).*(获得|奖励|领取成功|已领取).*"] > @ImageView',
                '@ImageView < [desc*="关闭"][desc!*="秒"][desc~="(?s).*(获得|奖励|领取成功|已领取).*"]',
                // 关闭描述节点本身没有图标子节点时，点它右侧的 ×
                '@[desc*="关闭"][desc!*="秒"][desc~="(?s).*(获得|奖励|领取成功|已领取).*"][childCount=0][height>20]',
              ],
            },
            {
              key: 11,
              name: '广告-误关弹出挽留框-点[继续看]',
              desc: '挽留框文字是图片，只能按弹窗比例点按钮位置',
              activityIds: 'com.ss.android.excitingvideo.ExcitingVideoActivity',
              actionDelay: 500,
              position: { left: 'width * 0.5', bottom: 'width * 0.3182' },
              matches: 'ImageView - @ViewGroup[childCount=1][width>600 && height>600][getChild(0).name$="ImageView"] -(1,2) ScrollView',
            },
            {
              key: 12,
              name: '广告-已无新视频-退出',
              matches: '@[clickable=true][width<120 && height<120] + LinearLayout > [text*="无新视频"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 2,
          name: '全屏广告-番茄红包弹窗',
          desc: '关闭「番茄发来的红包/恭喜发财」弹窗',
          enable: true,
          rules: [
            {
              key: 0,
              actionDelay: 300,
              matches: [
                '[text~="(?s).*(发来的红包|恭喜发财).*"][visibleToUser=true]',
                '@[desc~="(?i)(close|关闭)"][clickable=true][visibleToUser=true]',
              ],
            },
          ],
        },
        {
          key: 3,
          name: '局部广告-右侧悬浮红包挂件',
          desc: '关闭「登录领取/登录赚钱」等悬浮挂件；原订阅规则因关闭按钮被系统报告为不可见而失效',
          enable: true,
          rules: [
            {
              key: 0,
              name: '传统View版-关闭按钮在前',
              matches: '@ImageView[clickable=true][width<100 && height<100] + ViewGroup >n [text~="(?s).*(登录|领取|赚|红包|福利|金币|现金|奖励).*"][text.length<8][visibleToUser=true]',
            },
            {
              key: 1,
              name: 'Compose版-关闭按钮在后',
              // Compose 节点取不到父节点，只能用「兄弟 → 子孙」方向匹配
              matches: '@[desc~="(?i).*(close|关闭).*"][clickable=true] - * >n [text~="(?s).*(登录|领取|赚|红包|福利|金币|现金|奖励).*"][text.length<8][visibleToUser=true]',
            },
          ],
        },
        {
          key: 4,
          name: '功能类-看广告自动静音',
          desc: '广告开始时点一次左上角喇叭；与 id667 的「观看广告自动静音」二选一，同时开会点两次变回有声',
          enable: true,
          actionDelay: 1000,
          actionMaximum: 1,
          resetMatch: 'activity',
          rules: [
            {
              key: 0,
              // 定位右上角「x秒后可领…/获得…，关闭」那一栏左边的兄弟栏「广告 | 喇叭」，
              // 喇叭在这一栏最右端；该栏被系统报告为高度 0，只能按栏宽比例推算点击位置
              // 不用 prev、不往上找父节点，兼容取不到父节点的机型
              position: { right: 'width * 0.2255', top: 'width * 0.204' },
              matches: '@ViewGroup[index=0][width>100] + ViewGroup >n [desc*="关闭"][desc~="(?s).*(秒|获得|奖励|时长).*"]',
            },
          ],
        },
      ],
    },
  ],
}
